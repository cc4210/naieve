# Secrets / local config — keep the template
.env
.env*.local
!.env.example

# Node / Next
node_modules/
.next/
next-env.d.ts
npm-debug.log*

# Vercel (legacy — deploys now go through CodeBuild → ECR → ECS)
.vercel

# Docker volumes if ever bind-mounted
pgdata/

# Migrations must be committed: the Dockerfile does `COPY migrations ./migrations`,
# so a build from a clone without them fails. Negation needed because the global
# ~/.gitignore excludes *.sql, and repo rules take precedence over the global file.
!migrations/*.sql

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

docs/